# Run npm run setup to generate local secrets. Never commit .env.
DATABASE_URL=postgres://visibility:visibility@127.0.0.1:55432/visibility
APP_URL=http://localhost:3000
# 32 random bytes encoded as 64 hexadecimal characters
ENCRYPTION_KEY=
# Required to create the FIRST owner account; generated by setup
BOOTSTRAP_TOKEN=
# Installation-wide monthly ceiling, USD. Each organization also has a lower ceiling.
MAX_MONTHLY_BUDGET_USD=20
RETENTION_DAYS=365
# Total in-flight measurements across workers. Provider/model limits are managed in Settings.
WORKER_CONCURRENCY=12
# Docker database password (replace for deployment)
POSTGRES_PASSWORD=
# Only used for the optional HTTPS compose profile
APP_DOMAIN=visibility.example.com
